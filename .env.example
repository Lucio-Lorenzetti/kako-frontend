# Public Key de Mercado Pago (Checkout Bricks / Wallet en el navegador)
# Panel de Mercado Pago > Tu negocio > Configuracion > Credenciales de produccion
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client ID de Google (Google Identity Services) para "Iniciar sesion con Google"
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente de OAuth 2.0
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
